---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import MacAuthWorkspace from './MacAuthWorkspace';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const description = es
  ? 'Alice y Bob acuerdan una clave K con ECDH y HKDF, Alice autentica a Bob con un reto r y la etiqueta HMAC τ = MAC_K(r), y ambos derivan KE para intercambiar archivos cifrados con AES-128. OpenSSL en tu navegador. Práctica 07 de Selected Topics in Cryptography.'
  : 'Alice and Bob agree on a key K with ECDH and HKDF, Alice authenticates Bob with a challenge r and the HMAC tag τ = MAC_K(r), and both derive KE to exchange files encrypted with AES-128. OpenSSL in your browser. Selected Topics in Cryptography Lab 07.';
---
<Base title={es ? 'ECDH y MAC — OpenSSL' : 'ECDH and MAC — OpenSSL'} description={description}>
  <Header />
  <main class="relative mx-auto w-full max-w-[1200px] px-8 pt-28 pb-24 max-md:px-5">
    <a href={es ? '/es/practices' : '/practices'} class="inline-flex gap-2 font-mono text-sm text-text-secondary hover:text-accent mb-8">
      ← {es ? 'Volver a las prácticas' : 'Back to practices'}
    </a>
    <span class="block font-mono text-sm text-accent uppercase tracking-widest mb-3">{es ? 'Práctica' : 'Practice'} 14 · OpenSSL</span>
    <h1 class="text-[clamp(2.5rem,5vw,4rem)] font-extrabold tracking-tight uppercase mb-4">{es ? 'ECDH y MAC' : 'ECDH and MAC'}</h1>
    <p class="text-text-secondary text-lg leading-relaxed max-w-[760px] mb-10">{description}</p>
    <MacAuthWorkspace lang={lang} client:load />
  </main>
  <Footer lang={lang} />
</Base>
