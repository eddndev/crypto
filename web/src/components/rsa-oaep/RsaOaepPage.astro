---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import RsaOaepWorkspace from './RsaOaepWorkspace';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const description = es
  ? 'Alice genera claves RSA-OAEP con TCR; Bob cifra un archivo con AES-128 y envía la clave K cifrada con OAEP; Alice recupera K y descifra el archivo. OpenSSL en tu navegador. Práctica 06 de Selected Topics in Cryptography.'
  : 'Alice generates RSA-OAEP keys with CRT; Bob encrypts a file with AES-128 and sends the key K wrapped with OAEP; Alice recovers K and decrypts the file. OpenSSL in your browser. Selected Topics in Cryptography Lab 06.';
---
<Base title="RSA-OAEP — OpenSSL" description={description}>
  <Header />
  <main class="relative mx-auto w-full max-w-[1200px] px-8 pt-28 pb-24 max-md:px-5">
    <a href={es ? '/es/practices' : '/practices'} class="inline-flex gap-2 font-mono text-sm text-text-secondary hover:text-accent mb-8">
      ← {es ? 'Volver a las prácticas' : 'Back to practices'}
    </a>
    <span class="block font-mono text-sm text-accent uppercase tracking-widest mb-3">{es ? 'Práctica' : 'Practice'} 12 · OpenSSL</span>
    <h1 class="text-[clamp(2.5rem,5vw,4rem)] font-extrabold tracking-tight uppercase mb-4">RSA-OAEP</h1>
    <p class="text-text-secondary text-lg leading-relaxed max-w-[760px] mb-10">{description}</p>
    <RsaOaepWorkspace lang={lang} client:load />
  </main>
  <Footer lang={lang} />
</Base>
